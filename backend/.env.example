# The port for the backend API to listen on
PORT=3000

# Secret key for signing JSON Web Tokens for admin authentication
JWT_SECRET=your_jwt_secret_here

# Database connection URL for SQLite
DATABASE_URL="file:./quaeligo.db?connection_limit=1&busy_timeout=5000"

# Allowed CORS origins (comma-separated). e.g. "https://yourdomain.com,http://localhost:5173"
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
